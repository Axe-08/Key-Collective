{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "key-collective",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KEY_POOL",
        "class_name": "KeyPoolDO"
      },
      {
        "name": "DEMO_POOL",
        "class_name": "DemoDO"
      },
      {
        "name": "POOL_COORDINATOR",
        "class_name": "PoolCoordinatorDO"
      },
      {
        "name": "TENANT_QUOTA",
        "class_name": "TenantQuotaDO"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "KeyPoolDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DemoDO"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "PoolCoordinatorDO"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "TenantQuotaDO"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "RateLimiterDO"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "key-collective-d1",
      "database_id": "80e4f4f4-ca62-4273-9880-b0dc8a8b9ee0"
    }
  ],
  "routes": [
    {
      "pattern": "key-col.axe08.tech",
      "custom_domain": true
    },
    {
      "pattern": "api.key-col.axe08.tech",
      "custom_domain": true
    },
    {
      "pattern": "console.key-col.axe08.tech",
      "custom_domain": true
    },
    {
      "pattern": "admin.key-col.axe08.tech",
      "custom_domain": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "key_collective_telemetry"
    }
  ],
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "key-collective-568f8",
    "API_HOST": "api.key-col.axe08.tech",
    "CONSOLE_HOST": "console.key-col.axe08.tech",
    "ADMIN_HOST": "admin.key-col.axe08.tech",
    "APEX_HOST": "key-col.axe08.tech",
    "LEGACY_SUNSET": "Thu, 01 Jan 2026 00:00:00 GMT"
  },
  "env": {
    "dev": {
      "vars": {
        "FIREBASE_PROJECT_ID": "key-collective-568f8",
        "API_HOST": "api-dev.key-col.axe08.tech",
        "CONSOLE_HOST": "console-dev.key-col.axe08.tech",
        "ADMIN_HOST": "admin-dev.key-col.axe08.tech",
        "APEX_HOST": "dev.key-col.axe08.tech",
        "LEGACY_SUNSET": "Thu, 01 Jan 2026 00:00:00 GMT"
      },
      "routes": [
        {
          "pattern": "dev.key-col.axe08.tech",
          "custom_domain": true
        },
        {
          "pattern": "api-dev.key-col.axe08.tech",
          "custom_domain": true
        },
        {
          "pattern": "console-dev.key-col.axe08.tech",
          "custom_domain": true
        },
        {
          "pattern": "admin-dev.key-col.axe08.tech",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "key-collective-d1-dev",
          "database_id": "d0da8bb7-7583-418a-ab4f-be17b6990921"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KEY_POOL",
            "class_name": "KeyPoolDO"
          },
          {
            "name": "DEMO_POOL",
            "class_name": "DemoDO"
          },
          {
            "name": "POOL_COORDINATOR",
            "class_name": "PoolCoordinatorDO"
          },
          {
            "name": "TENANT_QUOTA",
            "class_name": "TenantQuotaDO"
          },
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiterDO"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "TELEMETRY",
          "dataset": "key_collective_telemetry_dev"
        }
      ]
    },
    "production": {
      "vars": {
        "FIREBASE_PROJECT_ID": "key-collective-568f8",
        "API_HOST": "api.key-col.axe08.tech",
        "CONSOLE_HOST": "console.key-col.axe08.tech",
        "ADMIN_HOST": "admin.key-col.axe08.tech",
        "APEX_HOST": "key-col.axe08.tech",
        "LEGACY_SUNSET": "Thu, 01 Jan 2026 00:00:00 GMT"
      },
      "routes": [
        {
          "pattern": "key-col.axe08.tech",
          "custom_domain": true
        },
        {
          "pattern": "api.key-col.axe08.tech",
          "custom_domain": true
        },
        {
          "pattern": "console.key-col.axe08.tech",
          "custom_domain": true
        },
        {
          "pattern": "admin.key-col.axe08.tech",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "key-collective-d1",
          "database_id": "80e4f4f4-ca62-4273-9880-b0dc8a8b9ee0"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KEY_POOL",
            "class_name": "KeyPoolDO"
          },
          {
            "name": "DEMO_POOL",
            "class_name": "DemoDO"
          },
          {
            "name": "POOL_COORDINATOR",
            "class_name": "PoolCoordinatorDO"
          },
          {
            "name": "TENANT_QUOTA",
            "class_name": "TenantQuotaDO"
          },
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiterDO"
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "TELEMETRY",
          "dataset": "key_collective_telemetry"
        }
      ]
    },
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "key-collective-d1-test",
          "database_id": "key-collective-d1-test"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KEY_POOL",
            "class_name": "KeyPoolDO"
          },
          {
            "name": "DEMO_POOL",
            "class_name": "DemoDO"
          },
          {
            "name": "POOL_COORDINATOR",
            "class_name": "PoolCoordinatorDO"
          },
          {
            "name": "TENANT_QUOTA",
            "class_name": "TenantQuotaDO"
          },
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiterDO"
          }
        ]
      }
    }
  }
}
