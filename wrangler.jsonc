{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "key-collective",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "KEY_POOL",
        "class_name": "KeyPoolDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["KeyPoolDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "key-collective-d1",
      "database_id": "local-d1-id"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "key_collective_telemetry"
    }
  ]
}
