```mermaid
stateDiagram-v2
    %% API Key States
    state "API Key States" as APIKeyStates {
        [*] --> Healthy
        Healthy --> RateLimited: on 429
        RateLimited --> HalfOpen: cooldown 60s via DO timer
        HalfOpen --> Healthy: probe success
        HalfOpen --> RateLimited: probe fail
    }

    %% Request States
    state "Request States" as RequestStates {
        [*] --> Received
        Received --> Authenticated
        Authenticated --> ModelResolved
        ModelResolved --> KeySelected
        KeySelected --> Proxied
        Proxied --> Fallback: on 429/5xx
        Fallback --> KeySelected: next key
        Fallback --> Failed: all keys exhausted
        Proxied --> [*]: success
    }

    %% Container Lifecycle
    state "Container Lifecycle" as ContainerLifecycle {
        [*] --> Idle
        Idle --> Active: on DO dispatch
        Active --> Sleeping: sleepAfter 10min
        Sleeping --> Active: DO keepalive ping every 8min
    }

    %% Tenant Budget States
    state "Tenant Budget States" as TenantBudgetStates {
        [*] --> ActiveBudget
        ActiveBudget --> Warned: at 80%
        Warned --> Exhausted: at 100%
        Exhausted --> ActiveBudget: reset on billing cycle
    }
```
