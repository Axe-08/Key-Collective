# Key Collective — Environment Variables Template
# Copy this file to .env (never commit .env — it is gitignored)
# For Cloudflare Workers production, use: wrangler secret put KC_MASTER_KEY

# ──────────────────────────────────────────────────────────────
# MASTER ENCRYPTION KEY (REQUIRED in production)
# Must be a strong, unique 32+ character passphrase.
# Used to derive per-tenant AES-256-GCM encryption keys.
# SEPARATE from ADMIN_TOKEN — do not share these values.
# Generate: openssl rand -base64 48
# ──────────────────────────────────────────────────────────────
KC_MASTER_KEY=

# ──────────────────────────────────────────────────────────────
# ADMIN AUTH TOKEN (REQUIRED for admin.* subdomain access)
# Must be DIFFERENT from KC_MASTER_KEY.
# Generate: openssl rand -base64 48
# ──────────────────────────────────────────────────────────────
ADMIN_TOKEN=

# ──────────────────────────────────────────────────────────────
# ADMIN EMAIL ALLOWLIST (optional, comma-separated)
# Users with these emails get admin access via D1 user lookup.
# ──────────────────────────────────────────────────────────────
ADMIN_EMAILS=

# ──────────────────────────────────────────────────────────────
# PROVIDER API KEYS (local dev / seeding only)
# In production, keys are stored encrypted in D1 per-tenant.
# DO NOT put real keys here. Use Cloudflare Secrets for prod.
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEYS=
GROQ_API_KEYS=
