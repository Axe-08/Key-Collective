# Key Collective — Environment Variables Template
# Copy this file to .env for environment reference (never commit .env — it is gitignored)
#
# FOR CLOUDFLARE WORKERS PRODUCTION:
# Store secrets in Cloudflare via Wrangler:
#   npx wrangler secret put KC_MASTER_KEY --env production
#   npx wrangler secret put ADMIN_TOKEN --env production
#   npx wrangler secret put TURNSTILE_SECRET --env production

# ──────────────────────────────────────────────────────────────
# MASTER ENCRYPTION KEY (REQUIRED in production)
# Must be a strong, unique 32+ character passphrase.
# Used by Web Crypto to derive per-tenant AES-256-GCM encryption keys.
# SEPARATE from ADMIN_TOKEN — do not share these values.
# Generate: openssl rand -base64 48
# ──────────────────────────────────────────────────────────────
KC_MASTER_KEY=

# ──────────────────────────────────────────────────────────────
# ADMIN AUTH TOKEN (REQUIRED for admin.* subdomain access)
# Bearer token for surveillance and circuit-breaker management.
# Must be DIFFERENT from KC_MASTER_KEY.
# Generate: openssl rand -base64 48
# ──────────────────────────────────────────────────────────────
ADMIN_TOKEN=

# ──────────────────────────────────────────────────────────────
# ADMIN EMAIL ALLOWLIST (optional, comma-separated)
# Users with these verified emails receive administrative permissions.
# ──────────────────────────────────────────────────────────────
ADMIN_EMAILS=

# ──────────────────────────────────────────────────────────────
# FIREBASE WEB AUTHENTICATION
# Used for Google OAuth and session authentication in the web console.
# ──────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=key-collective-568f8

# ──────────────────────────────────────────────────────────────
# CLOUDFLARE TURNSTILE (CAPTCHA / Anti-Sybil)
# Optional in dev; verified on public registration & anonymous demo leases.
# ──────────────────────────────────────────────────────────────
TURNSTILE_SECRET=

# ──────────────────────────────────────────────────────────────
# PROVIDER API KEYS (Local Dev / Seeding only)
# In production, keys are submitted by users and encrypted with AES-256-GCM.
# NEVER put real production keys in this file.
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
SAMBANOVA_API_KEYS=
