{
  "name": "key-collective",
  "version": "0.2.0",
  "description": "Cloudflare-native multi-tenant LLM router SaaS",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:ui": "vitest run --root ui && vitest run --root ui -c vitest.dom.config.ts",
    "gate:fast": "npm run typecheck && npm run test:unit && node scripts/check-no-sql-mocks.mjs",
    "gate": "npm run gate:fast && npm run test:workers && npm run test:ui",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:db": "vitest run tests/storage/migrations.test.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.41",
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^26.5.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^2.0.5",
    "wrangler": "^3.75.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
